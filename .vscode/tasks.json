{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "CMake Configure (Debug)",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build/cmake",
                "-G",
                "MinGW Makefiles",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "CMake Configure (Release)",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build/cmake",
                "-G",
                "MinGW Makefiles",
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "Build OpenGL Project (Debug)",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/cmake",
                "-j"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": "CMake Configure (Debug)",
            "detail": "Debug 构建：包含 -g 调试信息，用于断点排错"
        },
        {
            "type": "shell",
            "label": "Build OpenGL Project (Release)",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/cmake",
                "-j"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build"
            },
            "dependsOn": "CMake Configure (Release)",
            "detail": "Release 构建：开启 -O3 优化与 NDEBUG，获得极致运行帧率"
        }
    ]
}
